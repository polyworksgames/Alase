<%- include('partials/head', { title, description }) %>
<body>
<%- include('partials/header', { activePage }) %>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-container">
            <div class="hero-content">
                <h1 class="hero-title">
                    Healing <span class="highlight">Minds, Hearts</span><br>
                    and Souls
                </h1>
                <p class="hero-description">
                    Alase Center for Enrichment delivers comprehensive, trauma-informed peer support that bridges the gap between challenge and change. We empower individuals to take control of their journey, build resilience, and create lasting independence through compassion, connection, and community.
                </p>
                <div class="hero-buttons">
                    <a href="https://www.jotform.com/form/252594932823162" class="btn btn-primary">Start Your Journey</a>
                    <a href="#about" class="btn btn-secondary">Learn More</a>
                </div>
            </div>
            <div class="hero-image">
                <div class="hero-card">
                    <i class="fas fa-users"></i>
                    <h3>100+</h3>
                    <p>Lives Enriched</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <div class="section-header">
                <h2>About Alase Center for Enrichment</h2>
                <p>Building bridges to your future through meaningful peer connections</p>
            </div>
            <div class="about-grid">
                <div class="about-content">
                    <h3>Our Mission</h3>
                    <p>The Mission of Alase Center for Enrichment is to improve the quality of life and strengthen individuals, families and communities through the provision of direct mental health services. The center will provide a model of economic self-sufficiency within our community, specifically regarding mental health services. We use a multi modal approach to our treatment that considers the uniqueness of each entity. Ultimately we strive to provide a safe, comfortable and nurturing place where growth and transformation can occur.</p>

                    <div class="stats">
                        <div class="stat-item">
                            <h4>100%</h4>
                            <p>Active Mentors</p>
                        </div>
                        <div class="stat-item">
                            <h4>100+</h4>
                            <p>Lives Served</p>
                        </div>
                        <div class="stat-item">
                            <h4>100%</h4>
                            <p>Success Rate</p>
                        </div>
                    </div>
                </div>
                <div class="about-image">
                    <img src="/assets/logo.png" alt="Alase Center for Enrichment Logo" class="about-logo">
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="services">
        <div class="container">
            <div class="section-header">
                <h2>Our Services</h2>
                <p>Our work follows the Sequential Intercept Model, providing support at key touchpoints where care and community can make the greatest impact. Whether it's accessing housing, enrolling in school, finding a job, or simply feeling heard, Alase walks alongside each individual with compassion and consistency.
At Alase, we do more than support transitions — we build bridges to stability, relationships that heal, and legacies that empower. Every step forward becomes part of a larger story, one written not by systems, but by the people we serve.</p>
            </div>
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <h3>One-on-One Mentoring</h3>
                    <p>Personalized guidance from experienced mentors who understand your unique journey and challenges.</p>
                    <ul>
                        <li>Weekly scheduled sessions</li>
                        <li>Goal-setting and tracking</li>
                        <li>Confidential support</li>
                    </ul>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-door-open"></i>
                    </div>
                    <h3>Re-Entry Services</h3>
                    <p>Comprehensive support for individuals returning to the community after incarceration — housing, employment, and life skills.</p>
                    <ul>
                        <li>Housing placement assistance</li>
                        <li>Employment readiness</li>
                        <li>Community integration</li>
                    </ul>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-laptop"></i>
                    </div>
                    <h3>Virtual Mentoring</h3>
                    <p>Flexible online mentoring options that accommodate busy schedules and geographical constraints.</p>
                    <ul>
                        <li>Video conferencing</li>
                        <li>Digital resources</li>
                        <li>24/7 messaging support</li>
                    </ul>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3>Professional Development</h3>
                    <p>Career-focused mentoring to help you advance professionally and achieve your career goals.</p>
                    <ul>
                        <li>Resume and interview prep</li>
                        <li>Industry networking</li>
                        <li>Leadership training</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="testimonials">
        <div class="container">
            <div class="section-header">
                <h2>Success Stories</h2>
                <p>Hear from those who have transformed their lives through our enrichment programs</p>
            </div>
            <div class="testimonials-grid">
                <div class="testimonial-card">
                    <div class="testimonial-content">
                        <i class="fas fa-quote-left"></i>
                        <p>"The mentoring I received at Alase completely changed my perspective on my future. My mentor helped me identify my strengths and guided me toward a path I never considered."</p>
                    </div>
                    <div class="testimonial-author">
                        <h4>Alex Thompson</h4>
                        <p>Program Graduate</p>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="testimonial-content">
                        <i class="fas fa-quote-left"></i>
                        <p>"Through the group sessions, I not only found guidance but also built a network of supportive peers who continue to inspire me daily. Alase gave me hope."</p>
                    </div>
                    <div class="testimonial-author">
                        <h4>Maria Santos</h4>
                        <p>Re-Entry Program Participant</p>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="testimonial-content">
                        <i class="fas fa-quote-left"></i>
                        <p>"The virtual mentoring option was perfect for my situation. My mentor was always available and provided the flexibility I needed to rebuild my life."</p>
                    </div>
                    <div class="testimonial-author">
                        <h4>David Kim</h4>
                        <p>Program Participant</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="container">
            <div class="contact-content">
                <div class="contact-info">
                    <h2>Start Your Transformation Today</h2>
                    <p>Ready to connect with a mentor who understands your journey? Reach out to us and take the first step toward meaningful change.</p>

                    <div class="contact-details">
                        <div class="contact-item">
                            <i class="fas fa-phone"></i>
                            <div>
                                <h4>Phone</h4>
                                <p>(919) 957-7357</p>
                            </div>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-envelope"></i>
                            <div>
                                <h4>Email</h4>
                                <p>info@alase.org</p>
                            </div>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <div>
                                <h4>Address</h4>
                                <p>6015 Fayetteville Road, Ste 114, Durham, NC 27713</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="contact-form">
                    <form class="form">
                        <div class="form-group">
                            <label for="name" class="sr-only">Your Name</label>
                            <input type="text" id="name" placeholder="Your Name" required>
                        </div>
                        <div class="form-group">
                            <label for="email" class="sr-only">Your Email</label>
                            <input type="email" id="email" placeholder="Your Email" required>
                        </div>
                        <div class="form-group">
                            <label for="phone" class="sr-only">Your Phone</label>
                            <input type="tel" id="phone" placeholder="Your Phone">
                        </div>
                        <div class="form-group">
                            <label for="service" class="sr-only">Service Interest</label>
                            <select id="service" required>
                                <option value="">Select Service Interest</option>
                                <option value="one-on-one">One-on-One Mentoring</option>
                                <option value="reentry">Re-Entry Services</option>
                                <option value="sex-offender">Sex Offender Services</option>
                                <option value="virtual">Virtual Mentoring</option>
                                <option value="professional">Professional Development</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="message" class="sr-only">Message</label>
                            <textarea id="message" placeholder="Tell us about your goals and what you're looking for in a mentor..." rows="4" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-full">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

<%- include('partials/footer') %>
</body>
</html>
